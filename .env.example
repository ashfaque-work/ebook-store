# APP_NAME is the wordmark in the header and the default trading name below.
APP_NAME="eBook Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must include the port `composer dev` serves on. The public disk builds cover
# URLs from this, so getting it wrong breaks every image on the site.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL, to match production (Neon). MySQL still works — the suite runs
# on all three engines in CI — but Postgres is what the deployment targets, so
# developing on it avoids surprises like its case-sensitive LIKE.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ebook_store
DB_USERNAME=postgres
DB_PASSWORD=

# MySQL alternative:
# DB_CONNECTION=mysql
# DB_PORT=3306
# DB_USERNAME=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Business identity — shown on the legal pages and checked during payment
# gateway KYC. These must match your gateway application.
STORE_LEGAL_NAME="Your Registered Business Name"
STORE_TRADING_NAME="${APP_NAME}"
STORE_SUPPORT_EMAIL=support@example.com
STORE_SUPPORT_PHONE=
STORE_ADDRESS_LINE1=
STORE_ADDRESS_LINE2=
STORE_CITY=
STORE_STATE=
STORE_POSTCODE=
STORE_COUNTRY=India
STORE_JURISDICTION=
STORE_GSTIN=

# Refund policy — enforced in code, not only described in prose. The refunds
# page renders these exact values, so the published policy cannot drift from
# what the application actually does.
STORE_REFUND_WINDOW_DAYS=7
STORE_REFUND_MAX_READ_PERCENT=10
# Free text: how long the money takes to reach a statement after we send it.
STORE_REFUND_PROCESSING_DAYS="5-7 working days"
STORE_SUPPORT_RESPONSE_HOURS=48

STORE_CURRENCY=INR

# GST. Leave disabled until you actually hold a GSTIN - an unregistered
# seller must not charge tax or issue tax invoices.
STORE_GST_ENABLED=false

# Set to false to put the store up before Razorpay's KYC clears — which that
# review needs, since it reads your legal pages on a live URL. Browsing, samples,
# the reader and free books all work; paid titles say purchasing opens shortly
# rather than failing at checkout. Set it to true the day your live keys go in.
STORE_PAYMENTS_ENABLED=true
STORE_STATE_CODE=
STORE_DEFAULT_TAX_RATE=18

# Razorpay. Leave blank to use the built-in mock gateway, which runs the same
# checkout flow without touching the network. Test keys start rzp_test_.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Storage disks. Local by default; point these at object storage in
# production, because free hosting wipes the container's disk on redeploy.
PRIVATE_DISK=local
PUBLIC_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
