# Production environment for the free stack in docs/08-DEPLOYMENT.md.
# Copy the values into Render's dashboard; do not commit a filled-in copy.

APP_NAME="Your Store"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-store.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Neon serverless Postgres. Autosuspends after ~5 minutes idle and resumes on
# the next connection — no manual restore, which is why it beats Supabase for
# a portfolio demo nobody visits for a week. Also gives pgvector for later.
DB_CONNECTION=pgsql
DB_HOST=ep-<id>.<region>.aws.neon.tech
DB_PORT=5432
DB_DATABASE=ebook_store
DB_USERNAME=
DB_PASSWORD=
# Neon requires TLS.
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
# No worker process on the free plan: a queued job would never run.
QUEUE_CONNECTION=sync

# Object storage. The container is rebuilt on every deploy and takes
# storage/app with it, so books must not live on the local disk.
FILESYSTEM_DISK=r2
PRIVATE_DISK=r2
PUBLIC_DISK=r2-public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<your-public-bucket-url>

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

# Live keys start rzp_live_. Leave blank to fall back to the mock gateway,
# which is never what you want in production.
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shown on the legal pages and checked during Razorpay KYC. These must match
# the details on the application.
STORE_LEGAL_NAME=
STORE_TRADING_NAME="${APP_NAME}"
STORE_SUPPORT_EMAIL=
STORE_SUPPORT_PHONE=
STORE_ADDRESS_LINE1=
STORE_ADDRESS_LINE2=
STORE_CITY=
STORE_STATE=
STORE_POSTCODE=
STORE_COUNTRY=India
STORE_JURISDICTION=
STORE_GSTIN=

STORE_REFUND_WINDOW_DAYS=7
STORE_REFUND_MAX_READ_PERCENT=10
STORE_REFUND_PROCESSING_DAYS="5-7 working days"
STORE_SUPPORT_RESPONSE_HOURS=48

STORE_CURRENCY=INR

# Turn on only once you hold a GSTIN. An unregistered seller must not charge
# tax or issue tax invoices.
STORE_GST_ENABLED=false
STORE_STATE_CODE=
STORE_DEFAULT_TAX_RATE=18
